{
  "name": "traktgram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build-serverless.mjs",
    "deploy": "npm run build && npx tgcloud push",
    "migrate": "npx tgcloud migrate",
    "status": "npx tgcloud status",
    "configure": "node scripts/configure-trakt.mjs"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0",
    "esbuild": "^0.27.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@grammyjs/types": "^3.20.0",
    "grammy": "^1.43.0"
  },
  "engines": {
    "node": ">=20"
  }
}
